generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  INDIVIDUEL
  ORGANISATION
}

enum UserStatut {
  ACTIF
  INACTIF
  SUSPENDU
}

enum OrgRole {
  PROPRIETAIRE
  MANAGER
  EQUIPE_VEILLE
  LECTEUR
}

enum MembreStatut {
  ACTIF
  EN_ATTENTE
  DESACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum Frequency {
  ON_DEMAND
  DAILY
  WEEKLY
  MONTHLY
}

enum PerimeterType {
  GEOGRAPHIC
  SECTORAL
}

enum StakeholderRole {
  DECIDEUR
  ANALYSTE
  OBSERVATEUR
}

enum MonitoringType {
  TECHNOLOGICAL
  COMPETITIVE
  REGULATORY
  GEOPOLITICAL
  ECONOMIC
  SCIENTIFIC
  CYBERSECURITY
}

enum SourceType {
  RSS
  WEB
  API
  DOCUMENT
}

model User {
  id               String     @id @default(uuid())
  nom              String
  email            String     @unique
  mot_de_passe     String
  photo_url        String?
  type_utilisateur UserType
  statut           UserStatut @default(ACTIF)
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  organisations       Organisation[]       @relation("OrgOwner")
  memberships         MembreOrganisation[]
  individual_projects Project[]            @relation("UserProjects")
  refresh_tokens      RefreshToken[]
  password_reset_tokens PasswordResetToken[]
  activity_logs       UserActivityLog[]
  alerts              Alert[]
  folders             Folder[]
  stakeholders        ProjectStakeholder[]
}

model Organisation {
  id                String   @id @default(uuid())
  nom               String   @unique
  owner_id          String
  owner             User     @relation("OrgOwner", fields: [owner_id], references: [id])
  join_code_equipe  String?
  join_code_lecteur String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  members     MembreOrganisation[]
  projects    Project[]
  invitations InvitationOrganisation[]
  folders     Folder[]
}

model MembreOrganisation {
  id              String       @id @default(uuid())
  organisation_id String
  organisation    Organisation @relation(fields: [organisation_id], references: [id])
  user_id         String
  user            User         @relation(fields: [user_id], references: [id])
  role            OrgRole
  statut          MembreStatut @default(ACTIF)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
}

model Folder {
  id              String        @id @default(uuid())
  nom             String
  description     String?
  owner_user_id   String?
  owner_user      User?         @relation(fields: [owner_user_id], references: [id])
  organisation_id String?
  organisation    Organisation? @relation(fields: [organisation_id], references: [id])
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  projects Project[]
}

model Project {
  id              String         @id @default(uuid())
  nom             String
  description     String?
  monitoring_type MonitoringType @default(TECHNOLOGICAL)
  keywords        String[]
  frequency       Frequency      @default(DAILY)

  start_date DateTime  @default(now())
  end_date   DateTime?

  isActive   Boolean   @default(true)
  is_deleted Boolean   @default(false)
  deleted_at DateTime? // Pour un vrai soft delete

  folder_id       String?
  folder          Folder?       @relation(fields: [folder_id], references: [id])
  organisation_id String?
  organisation    Organisation? @relation(fields: [organisation_id], references: [id])
  owner_user_id   String?
  owner_user      User?         @relation("UserProjects", fields: [owner_user_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  sources      Source[]
  rawData      RawData[]
  results      WatchResult[]
  reports      Report[]
  alerts       Alert[]
  perimeters   ProjectPerimeter[]
  objectives   ProjectObjective[]
  scopes       Scope[] 
  stakeholders ProjectStakeholder[]
  processedItems ProcessedItem[]
}

model ProjectObjective {
  id         String   @id @default(uuid())
  content    String
  priority   Int      @default(1)
  project_id String
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  axes ProjectAxis[]
}

model ProjectAxis {
  id           String           @id @default(uuid())
  name         String
  description  String?
  priority     Int              @default(1)
  objective_id String
  objective    ProjectObjective @relation(fields: [objective_id], references: [id], onDelete: Cascade)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  hypotheses ProjectHypothesis[]
}

model ProjectHypothesis {
  id         String      @id @default(uuid())
  content    String
  priority   Int         @default(1)
  statut     String      @default("OPEN")
  axis_id    String
  axis       ProjectAxis @relation(fields: [axis_id], references: [id], onDelete: Cascade)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  collection_plans      CollectionPlan[]
  hypothesis_perimeters HypothesisPerimeter[]
}

model ProjectPerimeter {

  id           String        @id @default(uuid())
  name         String?      

  type         PerimeterType 
  value        String?       // Valeur optionnelle
  project_id   String
  project      Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  objective_id String?   
  axis_id      String?   
  created_at   DateTime      @default(now())
  hypothesis_perimeters HypothesisPerimeter[]

}

model HypothesisPerimeter {
  id            String            @id @default(uuid())
  hypothesis_id String
  hypothesis    ProjectHypothesis @relation(fields: [hypothesis_id], references: [id], onDelete: Cascade)
  perimeter_id  String
  perimeter     ProjectPerimeter  @relation(fields: [perimeter_id], references: [id], onDelete: Cascade)
  created_at    DateTime          @default(now())
}

model CollectionPlan {
  id                    String            @id @default(uuid())
  question              String
  priority              Int               @default(1)
  frequency             Frequency         @default(DAILY)
  collection_start_date DateTime          @default(now())
  collection_end_date   DateTime?

  is_active   Boolean   @default(true)
  last_run_at DateTime?
  // Correction ici : mettre @default(now()) pour que le scheduler le voie tout de suite
  next_run_at DateTime? @default(now()) 

  hypothesis_id String
  hypothesis    ProjectHypothesis @relation(fields: [hypothesis_id], references: [id], onDelete: Cascade)
  
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  sources       CollectionPlanSource[]
  jobs          CollectionJob[]
  keywords      CollectionPlanKeyword[]
}

model Scope {
  id    String        @id @default(uuid())
  type  PerimeterType
  value String

  project_id String
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  objective_id String?
  axis_id      String?

  created_at DateTime @default(now())
}

model CollectionPlanSource {
  id                 String         @id @default(uuid())
  source_type        String
  source_label       String
  source_url         String?
  frequency          Frequency      @default(DAILY)
  metadata           Json?
  collection_plan_id String
  collection_plan    CollectionPlan @relation(fields: [collection_plan_id], references: [id], onDelete: Cascade)
  created_at         DateTime       @default(now())
}

model CollectionPlanKeyword {
  id                 String         @id @default(uuid())
  keyword            String
  keyword_type       String         @default("PRINCIPAL")
  collection_plan_id String
  collection_plan    CollectionPlan @relation(fields: [collection_plan_id], references: [id], onDelete: Cascade)
  created_at         DateTime       @default(now())
}

model ProjectStakeholder {
  id         String          @id @default(uuid())
  role       StakeholderRole
  project_id String
  project    Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User            @relation(fields: [user_id], references: [id])
  created_at DateTime        @default(now())
}

model Source {
  id        String    @id @default(uuid())
  name      String
  url       String?
  type      SourceType @default(WEB)
  projectId String
  project   Project   @relation(fields: [projectId], references: [id])
  rawData   RawData[]
}

model RawData {
  id          String   @id @default(uuid())
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id])
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  url         String
  content     String   @db.Text
  publishedAt DateTime
  contentHash String   @unique
  metadata    Json?
  createdAt   DateTime @default(now())

  watchResult WatchResult?
}

model WatchResult {
  id        String   @id @default(uuid())
  title     String
  summary   String?
  sentiment String?
  trend     String?
  keywords  String[]
  sourceUrl String?
  rawDataId String?  @unique
  rawData   RawData? @relation(fields: [rawDataId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}

model InvitationOrganisation {
  id              String           @id @default(uuid())
  organisation_id String
  organisation    Organisation     @relation(fields: [organisation_id], references: [id])
  email           String
  role            OrgRole
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  created_at      DateTime         @default(now())
  expires_at      DateTime
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  user_id   String
  user      User      @relation(fields: [user_id], references: [id])
  token_hash String
  expires_at DateTime
  created_at DateTime  @default(now())
  used_at   DateTime?

  @@index([token_hash])
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  expires_at DateTime
  created_at DateTime @default(now())
}

model UserActivityLog {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  action     String
  entityType String?
  entityId   String?
  created_at DateTime @default(now())
}

model Alert {
  id        String   @id @default(uuid())
  message   String
  isRead    Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}

model Report {
  id        String   @id @default(uuid())
  format    String
  fileUrl   String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum TriggerType {
  MANUAL
  SCHEDULED
}

model CollectionJob {
  id                 String         @id @default(uuid())
  collection_plan_id String
  collection_plan    CollectionPlan @relation(fields: [collection_plan_id], references: [id], onDelete: Cascade)
  status             JobStatus      @default(PENDING)
  trigger_type       TriggerType    @default(MANUAL)
  started_at         DateTime?
  finished_at        DateTime?
  logs               Json?
  created_at         DateTime       @default(now())
}

model RawItem {
  id                 String    @id @default(uuid())
  project_id         String
  collection_plan_id String
  source_type        String
  source_name        String?
  source_url         String?
  article_url        String?
  file_path          String?   // ← AJOUTÉ pour PDF/UPLOAD
  title              String?
  content_raw        String?   @db.Text
  published_at       DateTime?
  fetched_at         DateTime  @default(now())
  hash               String    @unique
  metadata           Json?
  created_at         DateTime  @default(now())
  processed_item     ProcessedItem?

  @@index([project_id])          
  @@index([collection_plan_id]) 
}

enum ProcessingStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
}

model ProcessedItem {
  id                 String           @id @default(uuid())
  raw_item_id        String           @unique
  project_id         String
  collection_plan_id String?

  title              String?
  content_clean      String?          @db.Text
  content_excerpt    String?          @db.Text
  language           String?
  word_count         Int?
  char_count         Int?

  source_type        String?
  source_name        String?
  source_url         String?
  article_url        String?

  published_at       DateTime?
  processed_at       DateTime         @default(now())

  processing_status  ProcessingStatus @default(DONE)
  error_message      String?
  metadata           Json?

  raw_item  RawItem @relation(fields: [raw_item_id], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([collection_plan_id])
  @@index([language])
  @@index([processed_at])
}

model ProcessingJob {
  id           String           @id @default(uuid())
  project_id   String?
  plan_id      String?
  raw_item_id  String?

  status       ProcessingStatus @default(PENDING)
  trigger_type String           @default("MANUAL")

  total        Int              @default(0)
  processed    Int              @default(0)
  skipped      Int              @default(0)
  failed       Int              @default(0)

  started_at   DateTime?
  finished_at  DateTime?
  error        String?
  logs         Json?

  created_at   DateTime         @default(now())

  @@index([project_id])
  @@index([status])
}

enum HypothesisImpact {
  OPEN
  PARTIALLY_SUPPORTED
  SUPPORTED
  CONTRADICTED
  NEEDS_MORE_RESEARCH
}

model EnrichedItem {
  id                 String   @id @default(uuid())
  processed_item_id  String   @unique
  project_id         String
  collection_plan_id String?
  hypothesis_id      String?

  answer             String?  @db.Text
  summary            String?  @db.Text
  entities           Json?
  topics             Json?
  sentiment          String?
  relevance_score    Float?
  hypothesis_impact  HypothesisImpact @default(OPEN)
  confidence_score   Float?
  raw_response       Json?

  model_used         String?
  prompt_version     String?
  enriched_at        DateTime @default(now())

  @@index([project_id])
  @@index([hypothesis_id])
  @@index([collection_plan_id])
}

model AiEnrichmentJob {
  id                 String           @id @default(uuid())
  project_id         String?
  plan_id            String?
  hypothesis_id      String?

  status             ProcessingStatus @default(PENDING)
  trigger_type       String           @default("MANUAL")

  total              Int              @default(0)
  processed          Int              @default(0)
  skipped            Int              @default(0)
  failed             Int              @default(0)

  model_used         String?
  started_at         DateTime?
  finished_at        DateTime?
  error              String?
  logs               Json?
  created_at         DateTime         @default(now())

  @@index([project_id])
  @@index([status])
}

model HypothesisEvaluation {
  id             String           @id @default(uuid())
  hypothesis_id  String
  project_id     String

  status         HypothesisImpact @default(OPEN)
  confidence     Float?
  summary        String?          @db.Text
  evidence_count Int              @default(0)
  support_count  Int              @default(0)
  against_count  Int              @default(0)
  neutral_count  Int              @default(0)

  last_evaluated DateTime         @default(now())
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  @@unique([hypothesis_id])
  @@index([project_id])
}
