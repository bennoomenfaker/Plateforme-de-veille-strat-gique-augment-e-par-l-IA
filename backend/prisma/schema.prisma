// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (Types et Rôles)
// ==========================================

enum UserType {
  INDIVIDUEL
  ORGANISATION
}

enum OrgRole {
  PROPRIETAIRE
  EQUIPE_VEILLE
  LECTEUR
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

// ==========================================
// MODULE : IDENTITY & ACCESS (Multi-Tenant)
// ==========================================

model User {
  id               String               @id @default(uuid())
  nom              String               // Changé 'name' par 'nom' selon fiche technique [3]
  email            String               @unique
  mot_de_passe     String               // Changé 'password' par 'mot_de_passe' [3]
  type_utilisateur UserType             // INDIVIDUEL ou ORGANISATION [3, 4]
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt

  // Relations
  organisations    Organisation[]       @relation("OrgOwner")
  memberships      MembreOrganisation[]
  individual_projects Project[]         @relation("UserProjects")
  refresh_tokens   RefreshToken[]
  activity_logs    UserActivityLog[]
  alerts           Alert[]              // Lien vers les alertes personnelles
}

model Organisation {
  id          String               @id @default(uuid())
  nom         String
  owner_id    String
  owner       User                 @relation("OrgOwner", fields: [owner_id], references: [id])
  created_at  DateTime             @default(now())
  updated_at  DateTime             @updatedAt

  // Relations
  members     MembreOrganisation[]
  projects    Project[]
  invitations InvitationOrganisation[]
}

model MembreOrganisation {
  id              String       @id @default(uuid())
  organisation_id String
  organisation    Organisation @relation(fields: [organisation_id], references: [id])
  user_id         String
  user            User         @relation(fields: [user_id], references: [id])
  role            OrgRole      // PROPRIETAIRE, EQUIPE_VEILLE, LECTEUR [5]
  created_at      DateTime     @default(now())
}

// ==========================================
// MODULE : GESTION DE PROJET (Isolé)
// ==========================================

model Project {
  id                String         @id @default(uuid())
  nom               String         // Changé 'name' par 'nom' [5]
  description       String?
  keywords          String[]       
  watchType         String?        
  frequency         Frequency      @default(DAILY)
  isActive          Boolean        @default(true)
  
  // Isolation Multi-Tenant [5]
  organisation_id   String?        // Défini si projet d'organisation
  organisation      Organisation?  @relation(fields: [organisation_id], references: [id])
  owner_user_id     String?        // Défini si projet individuel
  owner_user        User?          @relation("UserProjects", fields: [owner_user_id], references: [id])

  // Relations fonctionnelles liées au projet (Isolation [2])
  sources           Source[]       
  results           WatchResult[]  
  reports           Report[]       
  alerts            Alert[]        
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
}

// ==========================================
// MODULE : SOURCES & COLLECTE (ETL)
// ==========================================

model Source {
  id        String   @id @default(uuid())
  url       String
  type      String   
  isGlobal  Boolean  @default(false)
  
  // Isolation
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
}

model RawData {
  id          String   @id @default(uuid())
  content     String   
  sourceUrl   String
  hash        String   @unique 
  collectedAt DateTime @default(now())
}

// ==========================================
// MODULE : ANALYSE & RESTITUTION
// ==========================================

model WatchResult {
  id              String   @id @default(uuid())
  title           String
  summary         String?  
  sentiment       String?  
  trend           String?  

  // Isolation
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id])
  createdAt       DateTime @default(now())
}

// ==========================================
// MODULE : SÉCURITÉ & TRAÇABILITÉ
// ==========================================

model InvitationOrganisation {
  id              String           @id @default(uuid())
  organisation_id String
  organisation    Organisation     @relation(fields: [organisation_id], references: [id])
  email           String
  role            OrgRole
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  created_at      DateTime         @default(now())
  expires_at      DateTime
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  expires_at DateTime
  created_at DateTime @default(now())
}

model UserActivityLog {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  action      String   // LOGIN, CREATE_PROJECT, etc. [2]
  entity_type String?
  entity_id   String?
  created_at  DateTime @default(now())
}

model Alert {
  id        String   @id @default(uuid())
  message   String
  isRead    Boolean  @default(false)
  
  // Double liaison pour isolation et notification
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}

model Report {
  id        String   @id @default(uuid())
  format    String   
  fileUrl   String
  
  // Isolation
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}
